# Berkas ini ikut repositori, dan karena itu tidak boleh memuat kredensial
# sungguhan. Nilai di bawah adalah setelan untuk menjalankan di komputer
# sendiri dengan XAMPP.
#
# Di server, isi yang dikosongkan di sini dengan nilai aslinya. Langkahnya
# ada di DEPLOY.md.

APP_NAME="Tuban Civic Map"
APP_SHORT_NAME=TCM
APP_WILAYAH=Tuban

# Diisi untuk server uji bawaan PHP: php -S localhost:8080 -t public public/index.php
APP_URL=http://localhost:8080
APP_BASE_PATH=

APP_DEBUG=true
APP_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wia
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------- email
# SMTP di domain sendiri lewat cPanel. Sandinya sengaja dikosongkan di
# berkas ini: begitu diisi, sandi itu ikut terdorong ke repositori publik
# pada commit berikutnya. Isi hanya di .env yang ada di server.
#
# Tanpa sandi, aplikasi tetap jalan. Yang terjadi, halaman daftar bilang
# terus terang bahwa email verifikasi belum bisa dikirim.
MAIL_HOST=beacon-its.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_AUTH=true
MAIL_USERNAME=katamamah@beacon-its.com
MAIL_PASSWORD=
MAIL_FROM=katamamah@beacon-its.com
MAIL_FROM_NAME="Tuban Civic Map"
MAIL_TIMEOUT=10
MAIL_DEBUG=0
MAIL_CODE_TTL=15
MAIL_CODE_ATTEMPTS=5

# ----------------------------------------------------------- pemasangan
# Kunci untuk public/pasang.php, halaman yang membuat tabel dan mengisi
# datanya di server yang tidak punya akses baris perintah. Selama baris ini
# kosong, halaman itu menjawab 404. Di komputer sendiri biarkan kosong, dan
# pakai database/seed.php langsung.
INSTALL_KEY=

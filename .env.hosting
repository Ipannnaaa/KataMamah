# Setelan untuk server beacon-its.com.
#
# Di server, salin berkas ini menjadi .env:
#
#   cp .env.hosting .env
#
# lalu isi tiga baris yang sengaja dikosongkan: DB_PASS, MAIL_PASSWORD, dan
# INSTALL_KEY. Ketiganya tidak pernah ditulis ke repositori, karena
# repositori ini publik.
#
# Berkas ini sendiri aman ikut repositori: nama basis data dan nama pengguna
# bukan rahasia, yang menjaganya adalah sandi.

APP_NAME="Tuban Civic Map"
APP_SHORT_NAME=TCM
APP_WILAYAH=Tuban

# Aplikasi menumpang di subfolder, karena beacon-its.com sudah dipakai situs
# lain dan Document Root domain utama tidak boleh dialihkan.
#
# APP_BASE_PATH berisi jalur folder proyek dilihat dari domain, tanpa garis
# miring dan tanpa kata public. Rewrite di .htaccess akar proyek yang
# menambahkan public di dalam server, sementara alamat yang dilihat peramban
# tetap /KataMamah/..., dan itulah yang dipotong aplikasi.
#
# Kalau nanti pindah ke subdomain sendiri, APP_URL jadi
# https://katamamah.beacon-its.com dan APP_BASE_PATH dikosongkan lagi.
APP_URL=https://beacon-its.com/KataMamah
APP_BASE_PATH=KataMamah

# Wajib false di server. Kalau true, pesan galat beserta potongan kode ikut
# tampil ke pengunjung.
APP_DEBUG=false

# Menandai cookie sesi sebagai secure. Jangan dinyalakan sebelum SSL benar
# benar aktif: cookie secure tidak dikirim lewat http, dan Anda tidak akan
# bisa masuk.
APP_HTTPS=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=beaconio_Katamamah
DB_USER=beaconio_katamamah
DB_PASS=

# ---------------------------------------------------------------- email
# Mailbox di domain sendiri lewat cPanel. Kalau koneksi ke port 465 ditolak
# dari dalam server, ganti ke MAIL_HOST=localhost, MAIL_PORT=25,
# MAIL_ENCRYPTION=none, MAIL_AUTH=false.
MAIL_HOST=beacon-its.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_AUTH=true
MAIL_USERNAME=katamamah@beacon-its.com
MAIL_PASSWORD=
MAIL_FROM=katamamah@beacon-its.com
MAIL_FROM_NAME="Tuban Civic Map"
MAIL_TIMEOUT=10
MAIL_DEBUG=0
MAIL_CODE_TTL=15
MAIL_CODE_ATTEMPTS=5

# ----------------------------------------------------------- pemasangan
# Kunci untuk public/pasang.php, halaman yang membuat tabel dan mengisi
# datanya. Selama baris ini kosong, halaman itu menjawab 404 dan tidak bisa
# dipakai siapa pun. Isi hanya selama memasang, lalu kosongkan lagi atau
# hapus berkas pasang.php-nya.
#
# Panjang minimal 16 karakter. Bikin yang acak, jangan sandi yang dipakai di
# tempat lain.
INSTALL_KEY=

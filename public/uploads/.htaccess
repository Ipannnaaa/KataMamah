# Folder unggahan publik. Isinya hanya foto gedung, dan foto tidak perlu
# diproses siapa pun — jadi di sini tidak ada yang boleh dieksekusi.
#
# Tiap server mematikan PHP dengan caranya sendiri, karena itu beberapa cara
# dipasang sekaligus. Yang memakai php_flag harus berada di dalam IfModule:
# tanpa mod_php, direktif itu tidak dikenal dan Apache menolak start.

<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>

<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .asp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8

# Tutup dulu semuanya, lalu buka tiga ekstensi gambar saja. Urutannya penting:
# aturan yang membuka harus datang setelah yang menutup.
<FilesMatch ".">
    Require all denied
</FilesMatch>

<FilesMatch "\.(jpe?g|png|webp)$">
    Require all granted
</FilesMatch>

Options -Indexes -ExecCGI

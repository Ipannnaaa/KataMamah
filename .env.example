# Salin menjadi .env lalu sesuaikan. File .env tidak boleh masuk repositori.

APP_NAME="Tuban Civic Map"
APP_SHORT_NAME=TCM
APP_WILAYAH=Tuban

# XAMPP tanpa vhost: aplikasi ada di http://localhost/wia/System/public
APP_URL=http://localhost/wia/System/public
APP_BASE_PATH=wia/System/public

# Dengan vhost sendiri (disarankan), DocumentRoot menunjuk ke System/public:
# APP_URL=http://wia.test
# APP_BASE_PATH=

APP_DEBUG=true
APP_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wia
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------- email
# Dipakai verifikasi email lewat PHPMailer. Kosongkan MAIL_HOST bila belum
# ada SMTP: aplikasi tetap jalan, tetapi halaman daftar mengatakan terus
# terang bahwa email verifikasi belum bisa dikirim.
#
# Gmail: host smtp.gmail.com, port 587, enkripsi tls, MAIL_USERNAME alamat
# Gmail Anda, dan MAIL_PASSWORD berupa App Password 16 huruf — bukan sandi
# akun. Penampung uji lokal (tests/smtp-sink.php, Mailpit, MailHog) biasanya
# port 1025, MAIL_ENCRYPTION=none, MAIL_AUTH=false.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS/587), ssl (SMTPS/465), atau none tanpa enkripsi.
MAIL_ENCRYPTION=tls
MAIL_AUTH=true
MAIL_FROM=no-reply@tubancivicmap.test
MAIL_FROM_NAME="Tuban Civic Map"
MAIL_REPLY_TO=
MAIL_TIMEOUT=15

# 0 diam, 1 pesan klien, 2 beserta jawaban server. Jangan >0 di produksi.
MAIL_DEBUG=0

# Lama tautan verifikasi berlaku, dalam jam.
MAIL_VERIFY_TTL=24

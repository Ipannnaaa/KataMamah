/.env
/storage/logs/*
/storage/cache/*
/storage/uploads/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/uploads/.gitkeep

# Foto gedung yang diunggah admin. Folder dan .htaccess-nya ikut repo,
# isinya tidak.
/public/uploads/lokasi/*
!/public/uploads/lokasi/.gitkeep

# Penampung SMTP uji (tests/smtp-sink.php) menulis ke storage/logs, yang
# sudah diabaikan di atas.
/vendor/
Thumbs.db
.DS_Store
